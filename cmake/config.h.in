/* Generated by our build — the equivalent of what libudfread's meson writes.
 *
 * Upstream ships no template for this file: meson synthesises it from a
 * configuration_data() dictionary. These are the same four entries, so the
 * sources see the config.h they expect without the submodule being touched.
 */
#cmakedefine HAVE_UDFREAD_VERSION_H 1
#cmakedefine HAVE_UNISTD_H 1
#cmakedefine HAVE_FCNTL_H 1
#cmakedefine HAVE_PTHREAD_H 1
